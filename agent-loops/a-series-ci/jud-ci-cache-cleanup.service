[Unit]
Description=Weekly age-based cleanup of the A Series CI caches (pnpm, Turbo, BuildKit)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ci-runner
Group=ci-runner
SupplementaryGroups=docker
ExecStart=/opt/jud-ci/agent-loops/a-series-ci/cache-cleanup.sh
TimeoutStartSec=60min
