[Unit]
Description=JUD GitHub Actions A Series runner @SLOT@
After=network-online.target user@1001.service tailscaled.service
Wants=network-online.target
Requires=user@1001.service

[Service]
Type=simple
User=ci-runner
Group=ci-runner
# Memory and CPU accounting for CI (slices/README.md); the slice is a proposal until installed.
Slice=jud-ci.slice
# CI talks to ci-runner's own rootless daemon, not the shared production daemon.
Environment=DOCKER_HOST=unix:///run/user/1001/docker.sock
Environment=XDG_RUNTIME_DIR=/run/user/1001
WorkingDirectory=/home/ci-runner/actions-runner-@SLOT@
ExecStart=/home/ci-runner/actions-runner-@SLOT@/run.sh
Restart=always
RestartSec=10
KillMode=process
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
