[Unit]
Description=Clean completed A Series CI resources
After=user@1001.service
Requires=user@1001.service

[Service]
Type=oneshot
User=ci-runner
Group=ci-runner
# The CI rootless daemon (rootless/setup-ci-rootless-docker.sh); never the shared daemon.
Environment=DOCKER_HOST=unix:///run/user/1001/docker.sock
Environment=XDG_RUNTIME_DIR=/run/user/1001
ExecStart=/usr/bin/python3 /opt/jud-ci/agent-loops/a-series-ci/cleanup.py --apply
TimeoutStartSec=45min
