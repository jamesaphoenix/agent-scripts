{
  "version": 1,
  "_comment": "Historical Studio Compose recovery inventory. All targets retired 2026-10-22: primary apps run on NAS; no shared dev containers remained. Native compute and ML services are managed separately. Do not re-enable legacy recovery schedules.",
  "defaults": {
    "temporalAddress": "100.116.99.19:7233",
    "temporalAddressEnvVar": "TEMPORAL_ADDRESS"
  },
  "apps": [
    {
      "id": "octospark-prod",
      "composeProject": "octospark-prod-live",
      "enabled": false,
      "startOrder": [
        "redis",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "mcp",
        "worker"
      ],
      "startDelaySeconds": {
        "redis": 3
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": [
          "com.octospark.auto-fix-runner.prod"
        ]
      }
    },
    {
      "id": "octospark-staging",
      "composeProject": "octospark-staging-live",
      "enabled": false,
      "startOrder": [
        "redis",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "mcp",
        "worker"
      ],
      "startDelaySeconds": {
        "redis": 3
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": [
          "com.octospark.auto-fix-runner.staging"
        ]
      }
    },
    {
      "id": "trace-learn-prod",
      "composeProject": "trace-learn-prod",
      "enabled": false,
      "startOrder": [
        "cloudsql-proxy",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "worker"
      ],
      "startDelaySeconds": {
        "cloudsql-proxy": 8
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": []
      }
    },
    {
      "id": "trace-learn-staging",
      "composeProject": "trace-learn-staging",
      "enabled": false,
      "startOrder": [
        "cloudsql-proxy",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "worker"
      ],
      "startDelaySeconds": {
        "cloudsql-proxy": 8
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": []
      }
    },
    {
      "id": "trace-learn-dev",
      "composeProject": "trace-learn",
      "enabled": false,
      "_comment": "Historical shared dev target. No matching containers remained at retirement on 22 October 2026. CI now runs on A Series.",
      "startOrder": [
        "postgres",
        "redis",
        "otel-collector",
        "spotlight"
      ],
      "startDelaySeconds": {},
      "temporal": {
        "enabled": false
      }
    }
  ]
}
