{
  "root": "/srv/jud",
  "docker_host": "unix:///var/run/docker.sock",
  "projects": ["octospark-staging", "trace-learn-staging", "octospark-prod", "trace-learn-prod"],
  "allow_repositories": {
    "octospark": [
      "europe-west3-docker.pkg.dev/octospark-prod/tx-agent-kit/api",
      "europe-west3-docker.pkg.dev/octospark-prod/tx-agent-kit/worker",
      "europe-west3-docker.pkg.dev/octospark-prod/tx-agent-kit/ml",
      "europe-west3-docker.pkg.dev/octospark-prod/tx-agent-kit/renderer",
      "europe-west3-docker.pkg.dev/octospark-prod/tx-agent-kit/media-runtime"
