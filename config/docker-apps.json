{
  "version": 1,
  "_comment": "Mac Studio CI infrastructure only. Product application stacks now run on Synology with Hetzner fallback. Native render and media workers are registered separately in launchd-tasks/registry.json.",
  "defaults": {
    "temporalAddress": "100.116.99.19:7233",
    "temporalAddressEnvVar": "TEMPORAL_ADDRESS"
  },
  "apps": [
    {
      "id": "octospark-prod",
      "composeProject": "octospark-prod-live",
      "enabled": false,
      "startOrder": [
        "redis",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "mcp",
        "worker"
      ],
      "startDelaySeconds": {
        "redis": 3
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": [
          "com.octospark.auto-fix-runner.prod"
        ]
      }
    },
    {
      "id": "octospark-staging",
      "composeProject": "octospark-staging-live",
      "enabled": false,
      "startOrder": [
        "redis",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "mcp",
        "worker"
      ],
      "startDelaySeconds": {
        "redis": 3
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": [
          "com.octospark.auto-fix-runner.staging"
        ]
      }
    },
    {
      "id": "trace-learn-prod",
      "composeProject": "trace-learn-prod",
      "enabled": false,
      "startOrder": [
        "cloudsql-proxy",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "worker"
      ],
      "startDelaySeconds": {
        "cloudsql-proxy": 8
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": []
      }
    },
    {
      "id": "trace-learn-staging",
      "composeProject": "trace-learn-staging",
      "enabled": false,
      "startOrder": [
        "cloudsql-proxy",
        "otel-collector",
        "otel-healthcheck",
        "api",
        "worker"
      ],
      "startDelaySeconds": {
        "cloudsql-proxy": 8
      },
      "temporal": {
        "enabled": true,
        "checkFromService": "api",
        "restartServicesAfterRepair": [
          "worker"
        ],
        "kickstartLaunchdAfterRepair": []
      }
    },
    {
      "id": "trace-learn-dev",
      "composeProject": "trace-learn",
      "enabled": true,
      "_comment": "Studio retains the shared dev Postgres, Redis, small OTEL collector and Spotlight. Retired Langfuse, Grafana, Prometheus and their supporting services are not restarted after the fleet stability cleanup. CI runs in its separate Colima engine.",
      "startOrder": [
        "postgres",
        "redis",
        "otel-collector",
        "spotlight"
      ],
      "startDelaySeconds": {},
      "temporal": {
        "enabled": false
      }
    }
  ]
}
